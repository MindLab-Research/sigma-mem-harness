      "kind": "same-row",
      "targets": [
        "user-turn",
        "tokenizer",
        "turn-controller",
        "native-kv-tail",
        "reader-decoder",
        "assistant-tokens"
      ]
    },
    {
      "kind": "same-row",
      "targets": [
        "write-timing",
