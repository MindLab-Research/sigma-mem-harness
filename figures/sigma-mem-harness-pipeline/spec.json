          "kind": "line",
          "role": "arrow",
          "line_style": "solid",
          "head": "filled"
        }
      },
      {
        "id": "compact-trigger",
        "label": "compact-triggered control",
        "swatch": {
          "kind": "line",
          "role": "arrow",
          "line_style": "dashed",
          "head": "filled"
        }
      }
    ]
  },
  "annotations": [
    {
      "id": "read-gate-note",
      "text": "Before first compact: H is write-only; after compact: reader state is armed.",
